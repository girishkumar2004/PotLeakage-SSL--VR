  beamText: {fileID: 704920704}
  startVoltage: 4.544
  startBeam: 322
  startDescription: Check the Voltage and Beam Level. Make sure both are within the
    safe operating limits.
  steps:
  - voltage: 4.200
    beam: 312
    description: Press AD again to continue adjusting the voltage and beam level
      toward the safe operating range.
